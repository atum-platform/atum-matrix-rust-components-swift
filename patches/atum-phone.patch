+    /// Read a custom room account-data event from the existing local store.
+    ///
+    /// This is a cached, read-only accessor. It performs no request and accepts
+    /// a string type so clients can validate vendor event JSON without growing
+    /// the generated enum for every custom event.
+    pub async fn account_data_raw(
+        &self,
+        event_type: String,
+    ) -> Result<Option<String>, ClientError> {
+        let event = self
+            .inner
+            .account_data(RoomAccountDataEventType::from(event_type))
+            .await?;
+        Ok(event.map(|raw| raw.json().get().to_owned()))
+    }
+
+    /// Fetch one global account-data event from the server through the SDK's
+    /// authenticated client. This is the canonical post-write race
+    /// reconciliation read; it exposes no token or arbitrary HTTP surface.
+    pub async fn fetch_global_account_data_raw(
+        &self,
+        event_type: String,
+    ) -> Result<Option<String>, ClientError> {
+        let event_type = GlobalAccountDataEventType::from(event_type);
+        let event = self
+            .inner
+            .client()
+            .account()
+            .fetch_account_data(event_type)
+            .await?;
+        Ok(raw_global_account_data_json(event))
+    }
